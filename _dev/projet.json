    "front": 8080,
    "api": 8000,
    "cdp": 10232,
    "cockpit": 7796,
    "docs": 8008
  },
  "commandes": {
    "installer": "poetry install --no-interaction && npm --prefix frontend ci --no-audit --no-fund",
    "verifier": "node {outils}/verifier-tout.js && npm --prefix frontend run lint",
    "tester": "ECOWATCH_API_KEY= MISTRAL_API_KEY= poetry run pytest backend/tests --ignore=backend/tests/models -q -p no:cacheprovider && npm --prefix frontend run test",
    "construire": "npm --prefix frontend run build",
    "lancer": {
      "api": "poetry run uvicorn backend.main:app --reload",
      "front": "npm --prefix frontend run dev"
    },
